generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Company {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  phoneNumber      String
  voicePhoneNumber String?  @unique
  timeZone         String   @default("America/Toronto")
  industry         String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User?
  aiConfiguration AIConfiguration?
  knowledgeBase   KnowledgeBase?

  aiEvaluations AIEvaluation[]

  voiceCalls VoiceCall[]
}

model User {
  id              String   @id @default(uuid())
  fullName        String
  email           String   @unique
  passwordHash    String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model AIConfiguration {
  id             String   @id @default(uuid())
  systemPrompt   String
  language       String   @default("fr")
  voice          String   @default("default")
  agentName      String   @default("AllenVoice")
  welcomeMessage String   @default("Bonjour, comment puis-je vous aider ?")
  temperature    Float    @default(0.3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum KnowledgeSourceType {
  TEXT
  FAQ
  PDF
  WORD
  EXCEL
  POWERPOINT
  CSV
  TXT
  IMAGE
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum KnowledgeAudience {
  CUSTOMER
  INTERNAL
}

enum AIEvaluationMode {
  ASK
  COMPARE
}

enum AIEvaluationStatus {
  SUCCESS
  ERROR
}

enum AIProviderType {
  OPENAI
  ANTHROPIC
}

enum VoiceCallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum VoiceMessageRole {
  CUSTOMER
  AGENT
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  documents KnowledgeDocument[]
}

model KnowledgeDocument {
  id         String              @id @default(uuid())
  title      String
  category   String?
  content    String              @default("")
  sourceType KnowledgeSourceType @default(TEXT)

  status   KnowledgeDocumentStatus @default(READY)
  audience KnowledgeAudience       @default(CUSTOMER)
  isActive Boolean                 @default(true)

  fileName String?
  mimeType String?
  fileSize Int?

  storageKey String?

  extractionMode String?
  pageCount      Int?
  failureReason  String?
  processedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  chunks KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, status, isActive])
}

model KnowledgeChunk {
  id         String @id @default(uuid())
  content    String
  chunkIndex Int

  sectionTitle String?
  pageNumber   Int?
  sheetName    String?
  slideNumber  Int?
  locatorLabel String?

  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AIEvaluation {
  id        String           @id @default(uuid())
  question  String
  mode      AIEvaluationMode
  createdAt DateTime         @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  results AIModelResult[]

  @@index([companyId, createdAt])
}

model AIModelResult {
  id           String             @id @default(uuid())
  provider     AIProviderType
  model        String
  answer       String?
  latencyMs    Int?
  inputTokens  Int?
  outputTokens Int?
  status       AIEvaluationStatus
  errorMessage String?
  createdAt    DateTime           @default(now())

  evaluationId String
  evaluation   AIEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([provider, createdAt])
}

model VoiceCall {
  id              String          @id @default(uuid())
  twilioCallSid   String          @unique
  fromNumber      String?
  toNumber        String?
  status          VoiceCallStatus @default(IN_PROGRESS)
  provider        AIProviderType?
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  messages VoiceMessage[]

  @@index([companyId, startedAt])
  @@index([status])
}

model VoiceMessage {
  id           String           @id @default(uuid())
  role         VoiceMessageRole
  text         String
  confidence   Float?
  provider     AIProviderType?
  model        String?
  latencyMs    Int?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime         @default(now())

  callId String
  call   VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
}
